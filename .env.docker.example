# Docker Compose 开发环境示例配置
# 使用方式：复制为 .env.docker 后按需修改；启动脚本会自动读取。

DB_ROOT_PASSWORD=rootpwd
DB_NAME=soumal
DB_USER=soumal
DB_PASSWORD=soumal
DB_CONNECTION_LIMIT=20

# 避免和本机 MySQL / Redis 冲突，容器端口默认映射到 3307 / 6380。
MYSQL_PORT=3307
REDIS_PORT=6380
SERVER_PORT=3001
WEB_PORT=5173

# 生产环境必须替换，不能使用示例值
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_EXPIRES_IN=7d

ADMIN_USERNAME=admin
# 生产环境必须替换，不能使用 CHANGE_ME 或 admin123
ADMIN_PASSWORD=CHANGE_ME
ADMIN_EMAIL=admin@legado.local

CORS_ORIGIN=http://localhost:5173
ENABLE_SOURCE_JS=false
REDIS_ENABLED=true
SEARCH_SOURCE_CONCURRENCY=10
SEARCH_GLOBAL_CONCURRENCY=10
