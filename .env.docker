# Docker Compose 开发环境配置

DB_ROOT_PASSWORD=rootpwd
DB_NAME=soumal
DB_USER=soumal
DB_PASSWORD=soumal

# 避免和本机 MySQL / Redis 冲突，容器端口默认映射到 3307 / 6380。
MYSQL_PORT=3307
REDIS_PORT=6380
SERVER_PORT=3001
WEB_PORT=5341

JWT_SECRET=legado-web-secret-key-change-in-development
JWT_EXPIRES_IN=7d

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@legado.local

CORS_ORIGIN=http://localhost:5341
ENABLE_SOURCE_JS=false
