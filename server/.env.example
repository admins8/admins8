# ============================================
# 生产环境配置 — 首次部署必须修改以下配置
# ============================================

# === 数据库配置（必填）===
DB_HOST=localhost
DB_PORT=3306
DB_USER=你的数据库用户名
DB_PASSWORD=你的数据库密码
DB_NAME=你的数据库名

# === JWT 配置（必填，至少24位随机字符串）===
JWT_SECRET=请修改为随机字符串-至少24位字符
JWT_EXPIRES_IN=7d

# === Redis 配置（生产环境必填）===
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379

# === 管理员账号（必填，密码至少10位）===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请修改为你的强密码
ADMIN_EMAIL=admin@yourdomain.com

# === 站点配置 ===
NODE_ENV=production
PORT=3000
SITE_URL=https://yourdomain.com
CORS_ORIGIN=https://yourdomain.com

# === 可选功能开关 ===
ENABLE_SOURCE_JS=false
